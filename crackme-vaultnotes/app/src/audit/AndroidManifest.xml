<?xml version="1.0" encoding="utf-8"?>
<!--
    Сборка audit: R8 обфусцирует её, как release, но приложение остаётся debuggable.
    Флаг выставлен в манифесте, а не через isDebuggable в Gradle: для debuggable-типов сборки
    AGP отключает обфускацию и оптимизации R8.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:debuggable="true"
        tools:ignore="HardcodedDebugMode" />
</manifest>
